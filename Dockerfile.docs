# Build context = repo root. The docs app lives in apps/docs, while the MDX
# content lives in docs/site, so the root context is required.
FROM node:22-bookworm-slim

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/docs/package.json apps/docs/package.json

RUN corepack enable && pnpm install --frozen-lockfile

COPY docs ./docs
COPY apps/docs ./apps/docs

WORKDIR /app/apps/docs
RUN pnpm build

ENV PORT=3004
EXPOSE 3004

CMD ["sh", "-c", "pnpm exec next start --hostname 0.0.0.0 --port ${PORT:-3004}"]
