# Build context MUST be the repo root (workspace Cargo.lock lives there).
#
# NOTE: nautilus-server is designed to run inside an AWS Nitro Enclave.
# It builds and serves HTTP fine on Railway, but the /get_attestation
# endpoint calls the NSM driver (/dev/nsm) which does not exist outside
# a Nitro Enclave and will return an error. Deploy here only for the
# non-attestation endpoints / integration testing.
FROM rust:1-bookworm AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential pkg-config libssl-dev cmake clang libclang-dev git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY Cargo.toml Cargo.lock ./
COPY apps ./apps

RUN cargo build --release -p nautilus-server --bin nautilus-server

FROM debian:bookworm-slim AS runtime
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates libssl3 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=builder /app/target/release/nautilus-server /usr/local/bin/nautilus-server

# main.rs reads ENCLAVE_PORT. Set it to Railway's $PORT at deploy time
# (see deployment guide) so the public domain routes correctly.
ENV ENCLAVE_PORT=43000
EXPOSE 43000
CMD ["nautilus-server"]
