# Build context MUST be the repo root (workspace Cargo.lock lives there).
#
# NOTE: this Dockerfile is TESTING-ONLY and is NOT reproducible. Use it for
# non-attestation integration testing (e.g. Railway): nautilus-server builds
# and serves HTTP fine, but /get_attestation calls the NSM driver (/dev/nsm),
# which does not exist outside a Nitro Enclave and will return an error.
#
# For the ATTESTABLE production enclave, do NOT use this image. Build the
# reproducible Oyster image (Marlin `nix.sh`) so PCRs are deterministic, then
# deploy/verify/register per docs/enclave-oyster-deploy.md.
FROM rust:1-bookworm AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential pkg-config libssl-dev cmake clang libclang-dev git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY Cargo.toml Cargo.lock ./
COPY apps ./apps

RUN cargo build --release -p nautilus-server --bin nautilus-server

FROM debian:bookworm-slim AS runtime
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates libssl3 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=builder /app/target/release/nautilus-server /usr/local/bin/nautilus-server

# main.rs reads ENCLAVE_PORT. Set it to Railway's $PORT at deploy time
# (see deployment guide) so the public domain routes correctly.
ENV ENCLAVE_PORT=43000
EXPOSE 43000
CMD ["nautilus-server"]
