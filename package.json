{
  "name": "dugong",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "dev:infra": "bash scripts/dev.sh --infra-only",
    "dev:down": "bash scripts/dev.sh --down",
    "dev:docs": "pnpm --filter @dugong/docs dev",
    "build:docs": "pnpm --filter @dugong/docs build",
    "check:docs": "pnpm --filter @dugong/docs check",
    "dev:web": "pnpm --dir apps/web --ignore-workspace dev",
    "build:web": "pnpm --dir apps/web --ignore-workspace build",
    "lint:web": "pnpm --dir apps/web --ignore-workspace lint",
    "preview:web": "pnpm --dir apps/web --ignore-workspace preview"
  }
}
