# dugong-indexer configuration.
#
# The indexer reuses the shared dugong-core `Config`, so `Config::from_env()`
# requires every variable below to be present — even though the indexer only
# actively uses DATABASE_URL, SUI_RPC_URL, DUGONG_EVENT_PACKAGE_ID and the INDEXER_*
# tuning knobs. The "required by shared Config but unused" block can hold any
# non-empty placeholder for local runs.

# ── Used by the indexer ──────────────────────────────────────────────────────
# Postgres the indexer mirrors Sui events into.
DATABASE_URL=postgres://postgres:password@localhost:45432/dugong

# Sui RPC + the package whose events are indexed.
# Both ids are populated automatically by scripts/deploy-contract.ts.
# DUGONG_EVENT_PACKAGE_ID is the ORIGINAL (defining) package id and is what the
# indexer filters events on — event type identity stays at the original id
# across upgrades, while DUGONG_PACKAGE_ID tracks the latest (move-call) id.
# DUGONG_EVENT_PACKAGE_ID falls back to DUGONG_PACKAGE_ID when unset.
SUI_RPC_URL=https://fullnode.testnet.sui.io:443
DUGONG_PACKAGE_ID=0x...
DUGONG_EVENT_PACKAGE_ID=0x...

# Indexer tuning (optional; defaults shown).
INDEXER_POLL_INTERVAL_MS=5000
INDEXER_BATCH_SIZE=50

# ── Required by the shared Config, also synced by deploy-contract.ts ──────────
DUGONG_REGISTRY_ID=0x...
ENCLAVE_CONFIG_ID=0x...
ENCLAVE_ID=0x...

# ── Required by the shared Config but NOT used by the indexer ─────────────────
# Any non-empty placeholder is fine locally.
REDIS_URL=redis://127.0.0.1:46379
TWITTERAPI_IO_API_KEY=unused
TWITTER_OAUTH2_CLIENT_ID=unused
TWITTER_OAUTH2_CLIENT_SECRET=unused
ENOKI_API_KEY=unused
BACKEND_SIGNER_PRIVATE_KEY=unused
