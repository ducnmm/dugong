# TwitterAPI.io Configuration
TWITTERAPI_IO_API_KEY=your_twitterapi_io_api_key_here

# Backend Configuration
BACKEND_URL=http://localhost:43001

# Polling Configuration
POLL_INTERVAL_SECONDS=60
# Maximum matching tweets forwarded to the backend per poll (must be greater than 0)
MAX_TWEETS_PER_POLL=1
TWITTER_MENTION=@DugongWallet
