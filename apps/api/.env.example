# Server
PORT=43001
LOG_LEVEL=info
RUST_LOG=dugong_api=debug,tower_http=debug
# Base URL used in docs/guide links.
DOCS_URL=http://127.0.0.1:3004
# Base URL used in tweet "View on tx" links.
WEB_URL=http://127.0.0.1:43173

# Database
DATABASE_URL=postgres://postgres:password@localhost:45432/dugong

# Redis
REDIS_URL=redis://127.0.0.1:46379

# TwitterAPI.io — used for READS only now (mention polling, user lookup,
# campaign candidate search) via X-API-Key. Reply POSTING has moved to the
# official X API (see TWITTER_BOT_USER_ID below).
TWITTERAPI_IO_API_KEY=your_twitterapi_io_api_key
# DEPRECATED: no longer used. Reply posting used to require scraped login
# cookies + a residential proxy; the official X API path does not. Safe to leave
# blank / remove (kept only for backward compatibility with the legacy
# dugong-login / dugong-test-tweet helpers).
TWITTERAPI_IO_LOGIN_COOKIES=
TWITTERAPI_IO_PROXY=
TWITTER_BOT_USERNAME=
TWITTER_BOT_EMAIL=
TWITTER_BOT_PASSWORD=
TWITTER_BOT_TOTP_SECRET=
# Required only if using X Account Activity webhook CRC instead of the worker poller
TWITTER_WEBHOOK_SECRET=

# Twitter OAuth 2.0
TWITTER_OAUTH2_CLIENT_ID=your_x_oauth2_client_id
TWITTER_OAUTH2_CLIENT_SECRET=your_x_oauth2_client_secret
TWITTER_OAUTH2_REDIRECT_URI=http://localhost:43173/callback

# Official X API reply posting (bot account) — OAuth 1.0a keys.
# From the X app's "Keys and tokens" page: consumer API Key/Secret plus the bot
# account's Access Token/Secret. When ALL FOUR are set, the processor signs
# POST /2/tweets with them directly and the OAuth 2.0 flow below is not needed
# (no dugong-bot-authorize, no DB-stored token). Partial configuration fails at
# startup. Regenerate these in the portal if they are ever exposed.
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=

# Official X API reply posting (bot account) — OAuth 2.0 alternative.
# The processor posts replies as the bot via POST /2/tweets, authenticating with
# the bot's OAuth 2.0 user-context token (stored encrypted in twitter_oauth_tokens).
# One-time setup:
#   1. Add a redirect URI to your X app (e.g. http://localhost:43173/callback).
#   2. Run: cargo run --bin dugong-bot-authorize
#      (needs TWITTER_OAUTH2_CLIENT_ID/SECRET, DATABASE_URL, TOKEN_ENCRYPTION_KEY)
#   3. Authorize as the BOT account, then set the printed id here.
# Optional: TWITTER_BOT_REDIRECT_URI overrides the redirect used during authorize.
TWITTER_BOT_USER_ID=

# OAuth credential security (API only — required at startup).
# TOKEN_ENCRYPTION_KEY: 32-byte AES-256-GCM key that encrypts stored Twitter
#   refresh tokens at rest. Base64 or hex. Generate with: openssl rand -base64 32
# SESSION_TOKEN_SECRET: HMAC secret (>= 16 chars) for signing backend session
#   tokens. Generate with: openssl rand -base64 48
# Rotating either value invalidates existing stored tokens/sessions, so users
# simply re-login once after a rotation.
TOKEN_ENCRYPTION_KEY=
SESSION_TOKEN_SECRET=

# Sui Network
# Contract IDs below are populated automatically by scripts/deploy-contract.ts.
SUI_RPC_URL=https://fullnode.testnet.sui.io:443
DUGONG_PACKAGE_ID=0x...
DUGONG_REGISTRY_ID=0x...      # DugongRegistry shared object (core.move)
ENCLAVE_CONFIG_ID=0x...
ENCLAVE_ID=0x... # Enclave shared object from register_enclave (NOT the config id)

# Prediction markets
MARKET_REGISTRY_ID=0x...           # MarketRegistry shared object (markets.move)
MARKET_TREASURY_ACCOUNT_ID=0x...   # Treasury DugongAccount (pass --treasury-account on deploy)
# MARKET_DEFAULT_FEE_BPS=100        # Optional; defaults to 1%

# Nautilus Enclave
ENCLAVE_URL=http://localhost:43000

# Gas sponsorship (Enoki)
ENOKI_API_KEY=your_enoki_api_key
ENOKI_NETWORK=testnet

# Backend signer (base64-encoded BCS SuiKeyPair)
BACKEND_SIGNER_PRIVATE_KEY=base64_bcs_keypair_here

# Indexer
INDEXER_POLL_INTERVAL_MS=5000
INDEXER_BATCH_SIZE=50
# ENABLE_INDEXER=false  # Set to true to run indexer in API server (not recommended for production)
