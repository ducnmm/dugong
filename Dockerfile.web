# Build context = repo root (same as the Rust services). Selected via
# RAILWAY_DOCKERFILE_PATH=Dockerfile.web on the `web` service.
FROM node:22-bookworm-slim AS builder
WORKDIR /app

# Vite inlines VITE_* at build time. Railway passes service variables as
# Docker build args automatically; declare them so the build can read them.
ARG VITE_API_BASE_URL
ARG VITE_ENCLAVE_URL
ARG VITE_DOCS_URL
ARG VITE_SUI_NETWORK
ARG VITE_DUGONG_PACKAGE_ID
ARG VITE_DUGONG_ACCOUNT_ADDRESS
ARG VITE_DUGONG_TRANSFER_ADDRESS
ARG VITE_DUGONG_ENCLAVE_ADDRESS
ARG VITE_ENCLAVE_CONFIG_ADDRESS
ARG VITE_TWITTER_CLIENT_ID
ARG VITE_TWITTER_REDIRECT_URI
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL \
    VITE_ENCLAVE_URL=$VITE_ENCLAVE_URL \
    VITE_DOCS_URL=$VITE_DOCS_URL \
    VITE_SUI_NETWORK=$VITE_SUI_NETWORK \
    VITE_DUGONG_PACKAGE_ID=$VITE_DUGONG_PACKAGE_ID \
    VITE_DUGONG_ACCOUNT_ADDRESS=$VITE_DUGONG_ACCOUNT_ADDRESS \
    VITE_DUGONG_TRANSFER_ADDRESS=$VITE_DUGONG_TRANSFER_ADDRESS \
    VITE_DUGONG_ENCLAVE_ADDRESS=$VITE_DUGONG_ENCLAVE_ADDRESS \
    VITE_ENCLAVE_CONFIG_ADDRESS=$VITE_ENCLAVE_CONFIG_ADDRESS \
    VITE_TWITTER_CLIENT_ID=$VITE_TWITTER_CLIENT_ID \
    VITE_TWITTER_REDIRECT_URI=$VITE_TWITTER_REDIRECT_URI

COPY apps/web/package.json apps/web/pnpm-lock.yaml ./
RUN corepack enable && pnpm install --frozen-lockfile
COPY apps/web/ ./
RUN pnpm build

FROM nginx:1.27-alpine AS runtime
COPY --from=builder /app/dist /usr/share/nginx/html

# Railway's shared nodes report the host's full CPU count, so the stock
# `worker_processes auto;` spawns ~32 nginx workers for a static SPA. Pin to 2.
RUN sed -i 's/^worker_processes.*/worker_processes 2;/' /etc/nginx/nginx.conf

# The base image defaults to `error_log ... notice;`, which spams the OS,
# getrlimit and per-worker startup notices into Railway's log stream. Raise the
# threshold to `warn` so only genuine warnings and errors surface. (No-op if a
# future base image drops the line.)
RUN sed -i 's#^error_log.*#error_log /var/log/nginx/error.log warn;#' /etc/nginx/nginx.conf

# SPA fallback + listen on Railway's $PORT (defaults to 8080 locally).
# The official nginx image runs envsubst over /etc/nginx/templates/*.template
# at startup, but the directory doesn't exist until we create it.
RUN mkdir -p /etc/nginx/templates && printf '%s\n' \
  'server {' \
  '  listen       ${PORT};' \
  '  server_name  _;' \
  '  root   /usr/share/nginx/html;' \
  '  index  index.html;' \
  '  location ~* \.(?:js|css|png|svg|ico|webmanifest|txt|woff2?)$ { access_log off; try_files $uri =404; }' \
  '  location / { try_files $uri $uri/ /index.html; }' \
  '}' > /etc/nginx/templates/default.conf.template

ENV PORT=8080
EXPOSE 8080
